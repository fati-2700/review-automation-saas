// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  companyName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  locations    Location[]
  brandVoice   BrandVoiceSettings?
  reviews      Review[]  @relation("LocationReviews")
}

model Location {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  address  String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews  Review[]
}

model Review {
  id           String    @id @default(uuid())
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("LocationReviews", fields: [userId], references: [id], onDelete: Cascade)
  customerName String?
  rating       Int
  reviewText   String
  reviewDate   DateTime  @default(now())
  status       String    @default("pending") // pending, responded, published
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  response     Response?
}

model Response {
  id             String           @id @default(uuid())
  reviewId       String           @unique
  review         Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  draftText      String
  finalText      String?
  status         String           @default("draft") // draft, approved, published
  characterCount Int              @default(0)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  history        ResponseHistory[]
}

model BrandVoiceSettings {
  id       String   @id @default(uuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tone     String   @default("professional") // professional, friendly, casual
  signOff  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResponseHistory {
  id             String   @id @default(uuid())
  responseId     String
  response       Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  text           String
  characterCount Int
  createdAt      DateTime @default(now())
}


